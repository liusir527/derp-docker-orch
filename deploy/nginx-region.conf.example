# 地区宿主(B)的宝塔 nginx 站点配置示例。把 <REGION> 换成地区 slug,<BASE_DOMAIN> 换成该地区基础域。
# 假设:通配证书 *.relay.<BASE_DOMAIN> 已签发到 /www/server/panel/vhost/cert/relay.<BASE_DOMAIN>/
#       nginx-proxy 监听 127.0.0.1:1443,regiond 监听 127.0.0.1:8081
server {
    listen 80;
    server_name relay.<BASE_DOMAIN> *.<BASE_DOMAIN>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name relay.<BASE_DOMAIN> *.<BASE_DOMAIN>;

    ssl_certificate     /www/server/panel/vhost/cert/relay.<BASE_DOMAIN>/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/relay.<BASE_DOMAIN>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # DERP 走 HTTP/2 与 WebSocket 升级,必须长超时、关闭缓冲。
    location / {
        proxy_pass http://127.0.0.1:1443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# 地区代理入口:只允许控制面(A)的 IP 访问。
server {
    listen 443 ssl;
    http2 on;
    server_name agent.relay.<BASE_DOMAIN>;

    ssl_certificate     /www/server/panel/vhost/cert/relay.<BASE_DOMAIN>/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/relay.<BASE_DOMAIN>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # allow <A_IP>;  deny all;
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }
}
